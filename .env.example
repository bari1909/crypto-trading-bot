# ===== Mode: paper | testnet | live (always start in paper, then testnet) =====
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
LIVE_ARMED=false
LIVE_TRADING_ACK=
LIVE_MAX_QUOTE_ALLOCATION=100

# Spot-only key, NO withdrawals, IP-restricted. Not needed for paper mode.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
# Spot Testnet keys from https://testnet.binance.vision (used only when TRADING_MODE=testnet)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ===== Universe & strategies =====
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,BNB/USDT,NEAR/USDT,UNI/USDT,DOGE/USDT,SUI/USDT,TRX/USDT,LINK/USDT,AVAX/USDT,ADA/USDT,LTC/USDT
QUOTE_CURRENCY=USDT
# Strategies the selector may choose from (empty = all 13). Available:
#  trend_follow_4h, turtle_breakout_4h, trend_pullback_4h, trend_pullback_15m, trend_pullback_1h,
#  mean_reversion_15m, mean_reversion_1h, donchian_breakout_1h, rsi2_dip_1h, squeeze_breakout_1h,
#  ema_momentum_5m
ENABLED_STRATEGIES=trend_follow_4h,turtle_breakout_4h

# ===== Risk =====
STARTING_EQUITY=100
RISK_PER_TRADE=0.005
MAX_POSITION_FRACTION=0.95
DAILY_LOSS_LIMIT=0.02
WEEKLY_LOSS_LIMIT=0.05
MAX_OPEN_POSITIONS=2
MAX_TRADES_PER_DAY=8
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=240
MAX_SPREAD_PCT=0.001

# ===== Costs (shared by backtest, selector, paper) =====
FEE_RATE=0.001
SLIPPAGE_RATE=0.0002

# ===== Selector =====
SELECTION_LOOKBACK_DAYS=60
SELECTOR_REFRESH_HOURS=6
SELECTOR_MIN_TRADES=12
SELECTOR_MIN_PROFIT_FACTOR=1.2
SELECTOR_MIN_EXPECTANCY_PCT=0.05
SELECTOR_MAX_DRAWDOWN_PCT=15

# ===== Infra =====
SCAN_INTERVAL_SECONDS=20
DATABASE_URL=postgresql+psycopg://scalper:scalper@db:5432/scalper
# Required for dashboard/API control buttons. Use a long random string.
API_TOKEN=
# Optional AI veto (can only block trades). Needs a valid model name.
AI_VETO_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
LOG_LEVEL=INFO

# ===== Futures bot (separate services: futures-worker / futures-api :8001 / futures-dashboard :8502) =====
# paper | testnet. The futures bot ALWAYS runs 1x leverage, isolated margin, long + short.
FUTURES_TRADING_MODE=paper
FUTURES_STRATEGIES=trend_follow_4h,turtle_breakout_4h,trend_follow_short_4h
FUTURES_FEE_RATE=0.0005
# testnet = testnet.binancefuture.com, demo = Binance Demo Trading (demo-fapi.binance.com)
FUTURES_TESTNET_VENUE=demo
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=
